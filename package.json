{
  "name": "unipile-cli",
  "version": "0.1.0",
  "description": "Agent-ready CLI for Unipile's LinkedIn API: accounts, profiles, relations, invitations, search, chats and messages",
  "type": "module",
  "author": "Jordan Bastin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nardjo/unipile-cli.git"
  },
  "homepage": "https://github.com/Nardjo/unipile-cli#readme",
  "bugs": {
    "url": "https://github.com/Nardjo/unipile-cli/issues"
  },
  "keywords": [
    "unipile",
    "linkedin",
    "cli",
    "api2cli",
    "automation",
    "ai-agents"
  ],
  "bin": {
    "unipile-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
